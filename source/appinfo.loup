@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "md";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Create directories (a Loup recreation of the Windows md / mkdir command).";

# Exit statuses returned by main(). Like cmd.exe's md, a usage error is
# ERRORLEVEL 1, the same as any other failure.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
