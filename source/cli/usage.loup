@mode(host.dual)

# Help and version text of md: what `md /?` prints (a short summary of this
# recreation's syntax) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/md by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `md /?`: a short summary of this recreation's syntax.
pub func usage(): string {
    let lines = [
        "Create directories.",
        "",
        "MD path [path ...]",
        "MKDIR is the same command.",
        "",
        "  path  A directory to create, with \\ or / between names. Missing",
        "        directories on the way are created as well: MD a\\b\\c works",
        "        when a does not exist yet.",
        "",
        "A path that already exists is reported, and md goes on with the others.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
