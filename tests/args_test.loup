@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, md_switches);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.help and !opts.version, "no help or version");
}

func test_md_has_no_switches(): void {
    expectEq(md_switches().len(), 0, "none declared");
}

func test_every_argument_is_a_directory(): void {
    let opts = parse_args(["new", "/s", "-q", "a\\b\\c", "/tmp/x"]).unwrap();
    expectEq(opts.operands.join(","), "new,/s,-q,a\\b\\c,/tmp/x", "operands in order");
}

func test_help(): void {
    expect(parse_args(["/?"]).unwrap().help, "/?");
    expect(parse_args(["new", "-?"]).unwrap().help, "-? with a directory");
    expect(parse_args(["--help"]).unwrap().help, "--help");
}

func test_version(): void {
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(!parse_args(["a", "--version"]).unwrap().version, "--version with a directory");
}

func test_double_dash(): void {
    let opts = parse_args(["--", "/?"]).unwrap();
    expect(!opts.help, "/? after -- is a directory");
    expectEq(opts.operands[0], "/?", "operand");
}
