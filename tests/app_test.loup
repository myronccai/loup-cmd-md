@mode(host.dual)

# Unit tests for md's whole command line (cli.app.run): exit statuses for
# help, version, a missing operand, and directories that are new, exist
# already or have a file on the way. These tests print the program's messages;
# their directories go under build/tmp/.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from io.fs import (createDir, isDir, removeDir, writeText);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func fresh(root: string): void {
    if (isDir(root)) {
        removeDir(root);
    }
    createDir(root);
}

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_no_operand_fails(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "syntax error");
}

func test_make_directories(): void {
    let root = "build/tmp/app_md";
    fresh(root);
    expectEq(run([root + "\\one", root + "/two\\three"]), EXIT_OK, "two operands");
    expect(isDir(root + "/one") and isDir(root + "/two/three"), "created");
    expectEq(run([root + "/one"]), EXIT_FAILURE, "already exists");
    expectEq(run([root + "/four", root + "/one"]), EXIT_FAILURE, "one of two exists");
    expect(isDir(root + "/four"), "the other one is still created");
    writeText(root + "/f.txt", "x\n");
    expectEq(run([root + "/f.txt\\sub"]), EXIT_FAILURE, "file on the way");
    removeDir(root);
}
